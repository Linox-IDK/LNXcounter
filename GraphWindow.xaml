<Window x:Class="LNXcounter.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        Title="{loc:Tr 'Chests per day, week and month'}" Width="900" Height="560" MinWidth="600" MinHeight="400" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_Down">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{loc:Tr 'CHESTS OPENED PER DAY'}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="✕" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton x:Name="TabDay" Style="{StaticResource TabRadio}" Content="{loc:Tr 'DAILY'}" GroupName="gr" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabWeek" Style="{StaticResource TabRadio}" Content="{loc:Tr 'WEEKLY'}" GroupName="gr" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabMonth" Style="{StaticResource TabRadio}" Content="{loc:Tr 'MONTHLY'}" GroupName="gr" Checked="Tab_Checked"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="0,10,0,10" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="8" Background="#FF0B0B0B">
                <Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="Plot_SizeChanged"/>
            </Border>

            <TextBlock Grid.Row="3" x:Name="Summary" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
