<Window x:Class="LNXcounter.HourToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        Title="{loc:Tr 'Treasure Hour'}" Width="392" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False" Icon="/Assets/logo.png">
    <Grid Margin="14,10,14,22">
        <Border x:Name="Card" Background="#F70E0E0E" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" CornerRadius="12"
                Cursor="Hand" MouseLeftButtonDown="Card_Down">
            <Border.Effect><DropShadowEffect x:Name="Glow" Color="#D4AF37" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
            <Grid>
                <Border CornerRadius="11" Opacity="0.9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A2F10" Offset="0"/><GradientStop Color="#0E0E0E" Offset="0.62"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="18,16,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top">
                            <Image.RenderTransform><RotateTransform x:Name="Wobble" CenterX="26" CenterY="26"/></Image.RenderTransform>
                        </Image>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#FF5BE37D" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Chip" Text="{loc:Tr 'LIVE NOW'}" Margin="7,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#FF5BE37D" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr 'TREASURE HOUR'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource GoldGradient}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="Boosts" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="Ends" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="3" Margin="0,14,0,0" Background="#33D4AF37" CornerRadius="1.5" ClipToBounds="True">
                        <Border x:Name="Bar" Background="{StaticResource GoldBrush}" CornerRadius="1.5" HorizontalAlignment="Left" Width="356"/>
                    </Border>
                    <Border Height="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
