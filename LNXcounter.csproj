<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LNXcounter</AssemblyName>
    <RootNamespace>LNXcounter</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <NoWarn>$(NoWarn);CS8618;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>
</Project>
