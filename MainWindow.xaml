<Window x:Class="LNXcounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        xmlns:local="clr-namespace:LNXcounter"
        Title="LNXcounter" Width="1190" Height="740" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" PreviewKeyDown="Window_PreviewKeyDown" WindowStartupLocation="CenterScreen" Icon="/Assets/logo.png">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Down" Margin="16,10,10,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="LNXcounter" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                    <Border Margin="12,0,0,0" Padding="9,2" CornerRadius="9" VerticalAlignment="Center" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" ToolTip="{loc:Tr 'Your Fortnite name'}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers><DataTrigger Binding="{Binding PlayerName}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PlayerName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}"/>
                    </Border>
                    <Ellipse Width="9" Height="9" Margin="9,0,0,0" VerticalAlignment="Center" Fill="#FF3DDC6E" ToolTip="{loc:Tr 'Fortnite is running'}">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding FortniteRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        <Ellipse.Effect><DropShadowEffect Color="#FF3DDC6E" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="OverviewTab" Style="{StaticResource TabRadio}" Content="{loc:Tr 'OVERVIEW'}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="DropsTab" Style="{StaticResource TabRadio}" Content="{loc:Tr 'DROPS'}" GroupName="tabs" Checked="Tab_Checked"/>
                    <Grid>
                        <RadioButton x:Name="SettingsTab" Style="{StaticResource TabRadio}" Content="{loc:Tr 'SETTINGS'}" GroupName="tabs" Checked="Tab_Checked"/>
                        <Ellipse Width="9" Height="9" Fill="#FFFF5A4F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0" IsHitTestVisible="False" ToolTip="{loc:Tr 'New update available'}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="—" Click="Min_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid x:Name="OverviewPanel" Grid.Row="1" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'CHESTS OPENED'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalOpened}" FontSize="92" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" Margin="0,-6,0,-4"/>
                                <TextBlock Text="{Binding CountNote}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TreasureNote}" Foreground="{StaticResource GoldBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Image Source="/Assets/chest.png" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="{loc:Tr 'TREASURES'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalTreasures}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="{loc:Tr 'MATCHES'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding MatchCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="{loc:Tr 'AVG / MATCH'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding AvgText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource Card}" ToolTip="{Binding TeamNote}">
                            <StackPanel><TextBlock Text="{loc:Tr 'TEAM CHESTS'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TeamChestsText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr 'RECENT MATCHES'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="{Binding BestMatchText}" FontSize="19" FontWeight="Black" Foreground="{StaticResource GoldGradient}"/>
                                <TextBlock Text="{Binding RecordsLine}" FontSize="12.5" Foreground="{StaticResource GoldLightBrush}" Margin="0,1,0,0"/>
                                <ItemsControl ItemsSource="{Binding Milestones}" Margin="0,8,0,0" ToolTip="{loc:Tr 'Chest milestones'}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Bg}" CornerRadius="9" Padding="9,2" Margin="0,0,6,0" ToolTip="{Binding Tip}">
                                                <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{Binding Fg}">
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding GoalVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding GoalText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                    <Border Height="6" CornerRadius="3" Background="#33D4AF37" Margin="0,4,0,0">
                                        <local:FractionBar Fraction="{Binding GoalFraction}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Matches}" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,1" Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"/>
                                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" ToolTip="{Binding FindsDetail}" Background="Transparent">
                                                    <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="{Binding FindsText, Mode=OneWay}" Foreground="{StaticResource GoldBrush}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource GoldBrush}">
                                                    <Run Text="{Binding Opened, Mode=OneWay}"/><Run Text="{loc:Tr ' opened'}" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                </TextBlock>
                                                <Button Grid.Column="3" Style="{StaticResource EyeButton}" Visibility="{Binding EyeVisibility}" Click="Eye_Click" ToolTip="{loc:Tr 'Show where the chests were'}">
                                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zM12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Treasure Hours: next window + the full list, in Paris time -->
                    <Border Grid.Row="0" Background="#1C1C1C" CornerRadius="16" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="20,20,20,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="104" Height="104" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE653" Offset="0"/><GradientStop Color="#F5BF00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Image Source="/Assets/token.png" Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.RenderTransform><TranslateTransform Y="0"/></Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="5" To="-6" Duration="0:0:1.8">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="9,3" Background="{Binding HeadBadgeBg}">
                                        <TextBlock Text="{Binding HeadBadge}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding HeadBadgeFg}"/>
                                    </Border>
                                    <TextBlock Text="{Binding HeadLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding HeadClock}" FontFamily="Segoe UI Black" FontSize="36" Foreground="White" Margin="0,-3,0,0"/>
                                    <TextBlock Text="{Binding HeadWhen}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-12,0" Click="Graph_Click" ToolTip="{loc:Tr 'Chests per day, week and month'}">
                                    <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M3 3h2v16h16v2H3V3zm4 9h3v6H7v-6zm5-5h3v11h-3V7zm5 3h3v8h-3v-8z"/>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="20,0,20,10">
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="-20,0,-20,14"/>
                                <TextBlock Text="{loc:Tr 'TREASURE HOURS'}" FontFamily="Segoe UI Black" FontSize="15" Foreground="White"/>
                                <TextBlock Text="{loc:Tr 'Every Treasure Hour so far and announced, in Paris time'}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Hours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,11,20,11" Opacity="{Binding Opacity}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding When, Mode=OneWay}" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="9,3" Background="{Binding BadgeBg}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                        </Border>
                                                    </Grid>
                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Margin="0,0,14,0" FontSize="12">
                                                            <Run Text="{loc:Tr 'Gold Outfit '}" Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Outfit, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,14,0" FontSize="12">
                                                            <Run Text="Pirate Shop Access " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Token, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12">
                                                            <Run Text="{loc:Tr 'Vehicle &amp; Decal '}" Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Vehicle, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Countdown}" Visibility="{Binding CountdownVisible}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9,20,11">
                                <TextBlock Text="{loc:Tr 'All times are Paris time. Epic announces each window a few days ahead.'}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" MaxHeight="262">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr 'OPENED BY TYPE'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Types}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== SETTINGS: a list of sections on the left, one section at a time on the right ===== -->
            <Grid x:Name="SettingsPanel" Grid.Row="1" Margin="24,14,24,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,4,16,0">
                    <Grid>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" GroupName="setnav" Content="{loc:Tr 'General'}" Tag="{loc:Tr 'Updates, startup and performance'}" IsChecked="True" Checked="SetPage_Checked"/>
                        <Ellipse Width="9" Height="9" Fill="#FFFF5A4F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" IsHitTestVisible="False" ToolTip="{loc:Tr 'New update available'}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <RadioButton x:Name="NavOverlay" Style="{StaticResource NavRadio}" GroupName="setnav" Content="{loc:Tr 'Overlay'}" Tag="{loc:Tr 'What shows over your game'}" Checked="SetPage_Checked"/>
                    <RadioButton x:Name="NavNotify" Style="{StaticResource NavRadio}" GroupName="setnav" Content="{loc:Tr 'Notifications'}" Tag="{loc:Tr 'Pop-ups and alerts'}" Checked="SetPage_Checked"/>
                    <RadioButton x:Name="NavCount" Style="{StaticResource NavRadio}" GroupName="setnav" Content="{loc:Tr 'Chests and goal'}" Tag="{loc:Tr 'Your count, adjustments and targets'}" Checked="SetPage_Checked"/>
                    <RadioButton x:Name="NavData" Style="{StaticResource NavRadio}" GroupName="setnav" Content="{loc:Tr 'Data'}" Tag="{loc:Tr 'Replays, export, backup, logs and uninstall'}" Checked="SetPage_Checked"/>
                </StackPanel>
                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{StaticResource LineBrush}" Margin="0,4,0,0"/>
                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel x:Name="SetGeneral" Visibility="Visible">
                            <TextBlock Text="{loc:Tr 'General'}" FontFamily="Segoe UI Black" FontSize="26" Foreground="White"/>
                            <TextBlock Text="{loc:Tr 'Updates, startup and performance'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,16"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'UPDATES'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Text="{Binding UpdateHeadline}" FontSize="17" FontWeight="Bold" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Foreground" Value="#FF5BE37D"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UpdateNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{loc:Tr 'Update now'}" MinWidth="110" Click="UpdateNow_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding UpdateBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Check now'}" MinWidth="110" Margin="8,0,0,0" Click="CheckUpdate_Click"/>
                                        <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Check automatically'}" Margin="22,0,0,0" Click="AutoUpdate_Click" IsChecked="True"/>
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" Text="{loc:Tr 'Tip: running  LNXcounter.exe -up  in a terminal opened in the folder of the exe updates it too.'}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'TIME FORMAT'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,10" LineHeight="19"
                                               Text="{loc:Tr 'How times are shown (Treasure Hours, matches): 8:00 PM or 20:00. Times are always Paris time.'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TfAuto" Style="{StaticResource TabRadio}" Content="{loc:Tr 'Like Windows'}" GroupName="tfmt" Checked="Tf_Click" IsChecked="True"/>
                                        <RadioButton x:Name="Tf12" Style="{StaticResource TabRadio}" Content="{loc:Tr '12-hour (8:00 PM)'}" GroupName="tfmt" Checked="Tf_Click"/>
                                        <RadioButton x:Name="Tf24" Style="{StaticResource TabRadio}" Content="{loc:Tr '24-hour (20:00)'}" GroupName="tfmt" Checked="Tf_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'START WITH WINDOWS'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'Opens LNXcounter quietly in the tray when you log in to Windows, so every match is counted. You can also switch this from the right-click menu of the tray icon or of the overlay.'}"/>
                                    <CheckBox x:Name="StartupBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Start LNXcounter with Windows'}" Click="Startup_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'ANIMATION SMOOTHNESS'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,10" LineHeight="19"
                                               Text="{loc:Tr 'Frames per second of the pulses and the floating token. 24 is light on the CPU and looks the same for most people; 60 and 120 are smoother but use more. The app restarts to apply it. (Low-resource mode always uses the lowest.)'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Fps24" Style="{StaticResource TabRadio}" Content="24 FPS" GroupName="fps" Click="Fps_Click" IsChecked="True"/>
                                        <RadioButton x:Name="Fps60" Style="{StaticResource TabRadio}" Content="60 FPS" GroupName="fps" Click="Fps_Click"/>
                                        <RadioButton x:Name="Fps120" Style="{StaticResource TabRadio}" Content="120 FPS" GroupName="fps" Click="Fps_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
