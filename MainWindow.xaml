<Window x:Class="LNXcounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LNXcounter"
        Title="LNXcounter" Width="1190" Height="740" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" PreviewKeyDown="Window_PreviewKeyDown" WindowStartupLocation="CenterScreen" Icon="/Assets/logo.png">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Down" Margin="16,10,10,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="LNXcounter" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="OverviewTab" Style="{StaticResource TabRadio}" Content="OVERVIEW" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="DropsTab" Style="{StaticResource TabRadio}" Content="DROPS" GroupName="tabs" Checked="Tab_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="—" Click="Min_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid x:Name="OverviewPanel" Grid.Row="1" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="CHESTS OPENED" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalOpened}" FontSize="92" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" Margin="0,-6,0,-4"/>
                                <TextBlock Text="counted from your replays, only the ones you opened yourself" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <Image Source="/Assets/chest.png" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="BROKEN" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalBroken}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="MATCHES" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding MatchCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="AVG / MATCH" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding AvgText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}"/></StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="RECENT MATCHES" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Matches}" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,1" Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"/>
                                                <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource GoldBrush}">
                                                    <Run Text="{Binding Opened, Mode=OneWay}"/><Run Text=" opened" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource GoldLightBrush}">
                                                    <Run Text="{Binding Broken, Mode=OneWay}"/><Run Text=" broken" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Treasure Hours: next window + the full list, in Paris time -->
                    <Border Grid.Row="0" Background="#1C1C1C" CornerRadius="16" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="20,20,20,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="104" Height="104" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE653" Offset="0"/><GradientStop Color="#F5BF00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Image Source="/Assets/token.png" Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.RenderTransform><TranslateTransform Y="0"/></Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="5" To="-6" Duration="0:0:1.8">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="9,3" Background="{Binding HeadBadgeBg}">
                                        <TextBlock Text="{Binding HeadBadge}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding HeadBadgeFg}"/>
                                    </Border>
                                    <TextBlock Text="{Binding HeadLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding HeadClock}" FontFamily="Segoe UI Black" FontSize="36" Foreground="White" Margin="0,-3,0,0"/>
                                    <TextBlock Text="{Binding HeadWhen}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="20,0,20,10">
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="-20,0,-20,14"/>
                                <TextBlock Text="TREASURE HOURS" FontFamily="Segoe UI Black" FontSize="15" Foreground="White"/>
                                <TextBlock Text="Every Treasure Hour so far and announced, in Paris time" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Hours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,11,20,11" Opacity="{Binding Opacity}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding When, Mode=OneWay}" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="9,3" Background="{Binding BadgeBg}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                        </Border>
                                                    </Grid>
                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Margin="0,0,14,0" FontSize="12">
                                                            <Run Text="Gold Outfit " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Outfit, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,14,0" FontSize="12">
                                                            <Run Text="Pirate Shop Access " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Token, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12">
                                                            <Run Text="Vehicle &amp; Decal " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Vehicle, Mode=OneWay}" Foreground="#3DDC6B" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Countdown}" Visibility="{Binding CountdownVisible}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9,20,11">
                                <TextBlock Text="All times are Paris time. Epic announces each window a few days ahead." FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" MaxHeight="262">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="OPENED BY TYPE" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Types}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== DROPS ===== -->
            <Grid x:Name="DropsPanel" Grid.Row="1" Margin="24,10,12,6" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- week 1..5 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Drops.Weeks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="pill" Style="{StaticResource GoldButton}" Content="{Binding Label}" Tag="{Binding Number}" IsEnabled="{Binding Available}"
                                    ToolTip="{Binding Tip}" Click="Week_Click" Margin="0,0,8,0" MinWidth="86"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ended}" Value="True">
                                    <Setter TargetName="pill" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#33D4AF37"/>
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                    <Setter TargetName="pill" Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- header: character, week, title, found, countdown -->
                <Grid Grid.Row="1" Margin="0,12,12,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="{Binding Drops.HeroIcon}" Height="92" Width="92" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Drops.WeekLabel}" Foreground="{Binding Drops.AccentBrush}" Opacity="{Binding Drops.LabelOpacity}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Drops.Title}" FontFamily="Segoe UI Black" FontSize="36" Foreground="{Binding Drops.TitleBrush}" Margin="0,-4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.2" VerticalAlignment="Center">
                                <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Drops.HasFound}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drops.HasFound}" Value="True">
                                                <Setter Property="Background" Value="#FF22B04F"/>
                                                <Setter Property="BorderBrush" Value="#FF22B04F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Drops.FoundText}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Drops.EndLabel}" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Drops.Countdown}" Foreground="{Binding Drops.AccentBrush}" FontWeight="Bold" FontSize="30" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,6">

                        <!-- the tile grid: 9 columns x 2 rows of square-ish frames -->
                        <ItemsControl ItemsSource="{Binding Drops.Tiles}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/>
                                            <ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="126"/></Grid.RowDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                    <Setter Property="Grid.Column" Value="{Binding Col}"/>
                                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColSpan}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:ClipBorder x:Name="tile" Background="{Binding Background}" CornerRadius="14" Margin="5" Cursor="Hand" MouseLeftButtonUp="Tile_Click"
                                                      BorderBrush="#40FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Image x:Name="icon" Source="{Binding Icon}" Width="{Binding IconSize}" Stretch="{Binding IconStretch}"
                                                   VerticalAlignment="{Binding IconAlign}" Margin="{Binding IconMargin}"
                                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.RenderTransform>
                                                    <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform Y="0"/></TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <!-- found: a small black-and-gold gradient over the frame -->
                                            <Border x:Name="foundGlow" Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#66000000" Offset="0"/>
                                                        <GradientStop Color="#00000000" Offset="0.5"/>
                                                        <GradientStop Color="#44E8B923" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- week ended: everything a bit darker -->
                                            <Border x:Name="dimmer" Background="#8C000000" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            <!-- shown on hover: dark shade with the item's category and name -->
                                            <Border x:Name="shade" Opacity="0" VerticalAlignment="Bottom" IsHitTestVisible="False" Padding="11,30,10,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00100C04" Offset="0"/>
                                                        <GradientStop Color="#D9100C04" Offset="0.4"/>
                                                        <GradientStop Color="#F0100C04" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="#FFD7D0B8"/>
                                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Black" FontSize="13" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Style="{StaticResource FoundCheck}" IsChecked="{Binding Found, Mode=TwoWay}" Visibility="{Binding CheckVisibility}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" ToolTip="Mark as found"/>
                                        </Grid>
                                    </local:ClipBorder>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Found}" Value="True">
                                            <Setter TargetName="foundGlow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="tile" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="tile" Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFF3D766" Offset="0"/>
                                                        <GradientStop Color="#FF2A2005" Offset="0.5"/>
                                                        <GradientStop Color="#FFD4AF37" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                            <Setter TargetName="dimmer" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- hover: the picture grows a little and the info shade fades in -->
                                        <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- the token hovers up and down inside its frame -->
                                        <DataTrigger Binding="{Binding Floats}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         From="7" To="-9" Duration="0:0:1.8">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- odds list -->
                        <Border Background="#1C1C1C" CornerRadius="16" Margin="5,12,5,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Margin="20,15,20,11">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.5" Duration="0:0:0.9"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.5" Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="DROP ODDS" FontFamily="Segoe UI Black" FontSize="15" Foreground="White" Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Each chest you open in a normal match" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    <Border BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="2,0,0,0" Margin="0,10,0,0" Padding="10,1,0,1">
                                        <TextBlock FontSize="12" Foreground="#FFB9B4A6" TextWrapping="Wrap"
                                                   Text="“Treasure drop rates from chests are constant since season launch and don't vary throughout the day, except during Treasure Hours. Other than Gizmos, you can't get the same treasure twice.” – Epic Games"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Drops.Odds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="64">
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                                                <Grid Margin="16,0">
                                                    <local:ClipBorder Width="46" Height="46" CornerRadius="11" Background="{Binding IconBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </local:ClipBorder>
                                                    <TextBlock Text="{Binding Name}" Margin="62,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Black" FontSize="14.5" Foreground="White"/>
                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OneInText}" FontFamily="Segoe UI Black" FontSize="14.5" Foreground="White" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PctText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- expected drops at the user's chest count -->
                        <Border Style="{StaticResource Card}" Margin="5,12,5,0" Padding="16,11">
                            <StackPanel>
                                <TextBlock Text="EXPECTED FROM YOUR CHESTS" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Drops.ExpectedText}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Hover a tile to see what it is, tick the box when you find a drop."
                                           FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="20,4,20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoldBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="460" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OverlayBtn" Style="{StaticResource GoldButton}" Content="Overlay" Click="Overlay_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="Folder…" Click="Folder_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="Rescan all" Click="Rescan_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="Reset" Click="Reset_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== reward popup ===== -->
            <Grid x:Name="ModalLayer" Grid.RowSpan="3" Panel.ZIndex="50">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Drops.IsModalOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#C0000000" CornerRadius="11" Margin="1" MouseLeftButtonDown="Backdrop_Down"/>
                <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Background="#FF1F1F1F"
                        BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="22,20,22,18" DataContext="{Binding Drops.Open}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Margin="0,0,44,0">
                                <TextBlock Text="{Binding Category}" FontFamily="Segoe UI Black" FontSize="11.5" Foreground="#FF9A9A9A"/>
                                <TextBlock Text="{Binding ModalTitle}" FontFamily="Segoe UI Black" FontSize="22" Foreground="White" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource CaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Click="ModalClose_Click" FontSize="16"/>
                        </Grid>
                        <local:ClipBorder CornerRadius="14" Height="190" Margin="0,16,0,0" Background="{Binding ModalBg}">
                            <Grid>
                                <Image Source="{Binding Icon}" Stretch="{Binding ModalStretch}" Margin="{Binding ModalMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Button Content="▶  PREVIEW" Style="{StaticResource PillButton}" Visibility="{Binding LoadingVisibility}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Click="Preview_Click"/>
                            </Grid>
                        </local:ClipBorder>

                        <!-- jam tracks: play the song (official YouTube upload, played inside the app) -->
                        <StackPanel Visibility="{Binding AudioVisibility}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundPlay}" Content="{Binding Audio.PlayGlyph}" Click="Jam_Click"/>
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="12,0,12,0" Minimum="0" Maximum="{Binding Audio.DurMax}" Value="{Binding Audio.Pos, Mode=OneWay}"
                                        PreviewMouseLeftButtonDown="Progress_Down" PreviewMouseLeftButtonUp="Progress_Up"/>
                                <TextBlock Grid.Column="2" Text="{Binding Audio.TimeText}" Foreground="#FF9A9A9A" FontSize="12" VerticalAlignment="Center" MinWidth="78" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Audio.VolumeGlyph}" FontSize="15" Foreground="#FFB9B4A6" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100" Value="{Binding Audio.Volume, Mode=TwoWay}" ToolTip="Volume"/>
                                <Button Grid.Column="2" Content="Open on YouTube ↗" Style="{StaticResource CaptionButton}" Width="Auto" Height="Auto" Padding="6,3" HorizontalAlignment="Right" FontSize="11" Click="Youtube_Click"/>
                            </Grid>
                            <TextBlock Text="{Binding Audio.Message}" Foreground="#FFE5A23C" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,16,0,0">
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding TierBg}" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding TierText}" Foreground="{Binding TierFg}" FontFamily="Segoe UI Black" FontSize="13"/>
                            </Border>
                            <CheckBox Style="{StaticResource FoundToggle}" IsChecked="{Binding Found, Mode=TwoWay}" Visibility="{Binding CheckVisibility}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding Info}" Foreground="#FF8F8F8F" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <TextBlock Text="The token is the same in every week, so one tick counts everywhere." Visibility="{Binding SharedNoteVisibility}"
                                   Foreground="#FF6F6F6F" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== loading screen preview ===== -->
            <local:ClipBorder x:Name="PreviewLayer" Grid.RowSpan="3" Panel.ZIndex="60" CornerRadius="11" Margin="1" Background="#F5000000">
                <local:ClipBorder.Style>
                    <Style TargetType="local:ClipBorder">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Drops.Previewing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:ClipBorder.Style>
                <local:ClipBorder Width="1130" Height="635.6" CornerRadius="10" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Image Source="{Binding Drops.Open.Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border VerticalAlignment="Bottom" Height="230" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#A0000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Drops.Connecting}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,40"
                               FontFamily="Segoe UI Black" FontSize="46" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.85"/></TextBlock.Effect>
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="600">
                        <Button Style="{StaticResource FnClose}" HorizontalAlignment="Right" Margin="0,0,40,-4" Click="PreviewClose_Click"/>
                        <Grid>
                            <Polygon Points="0,0 600,26 600,150 0,150" Fill="#FF34438F" Stretch="Fill"/>
                            <TextBlock Text="{Binding Drops.Tip}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="21" TextWrapping="Wrap" Margin="34,38,30,22"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                </local:ClipBorder>
            </local:ClipBorder>
        </Grid>
    </Border>
</Window>
