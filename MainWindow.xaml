                                    <TextBlock Text="{loc:Tr 'Support on Ko-fi (optional)'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="SetOverlay" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr 'Overlay'}" FontFamily="Segoe UI Black" FontSize="26" Foreground="White"/>
                            <TextBlock Text="{loc:Tr 'What shows over your game'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,16"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'OVERLAY STYLE'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'The small window that stays on top of your game. Click a style to use it. This is how each one looks with your real numbers.'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="OvFullTile" Tag="full" Cursor="Hand" Background="Transparent" BorderThickness="2" CornerRadius="12" Padding="10" Margin="0,0,14,0" MouseLeftButtonUp="OvStyle_Click">
                                            <StackPanel>
                                                <Border Background="#F2101010" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8" Width="250">
                                                    <StackPanel>
                                                        <Grid Height="26">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Column="1" Text="LNXcounter" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldGradient}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalOpened}" VerticalAlignment="Center" FontWeight="Bold" FontSize="17" Foreground="{StaticResource GoldLightBrush}"/>
                                                        </Grid>
                                                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,6,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{loc:Tr 'Treasure Hours'}" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" FontSize="12.5"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PirateShort}" HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding OverlayStatus}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{loc:Tr 'Full'}" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="OvMiniTile" Tag="mini" Cursor="Hand" Background="Transparent" BorderThickness="2" CornerRadius="12" Padding="10" MouseLeftButtonUp="OvStyle_Click">
                                            <StackPanel>
                                                <!-- the corner of a game screen: a minimap, and under it the chest icon and the count -->
                                                <Border Width="250" Height="120" CornerRadius="9" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2F6AA0" Offset="0"/><GradientStop Color="#FF173047" Offset="1"/></LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel HorizontalAlignment="Right" Margin="0,9,12,0">
                                                        <Border Width="62" Height="62" CornerRadius="3" Background="#FF86A64E" BorderBrush="#FF31401F" BorderThickness="1.5"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Image Source="/Assets/chest.png" Width="30" Height="30" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>
                                                            <TextBlock Text="{Binding OverlayNumber}" Margin="5,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Black" FontSize="22" Foreground="White">
                                                                <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/></TextBlock.Effect>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{loc:Tr 'Minimal'}" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                                                <TextBlock Text="{loc:Tr 'MINIMAL OVERLAY'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'Minimal puts itself under the minimap of Fortnite at 1080p, 1440p and 4K. It cannot be clicked or moved, and it only shows while Fortnite is in front. If your HUD scale is different, nudge it here (you can see it while this window is in front).'}"/>
                                    <TextBlock Text="{loc:Tr 'Fine-tune the position'}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource GoldButton}" Content="◀" Tag="-4,0" MinWidth="40" Click="Nudge_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="▶" Tag="4,0" MinWidth="40" Margin="6,0,0,0" Click="Nudge_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="▲" Tag="0,-4" MinWidth="40" Margin="6,0,0,0" Click="Nudge_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="▼" Tag="0,4" MinWidth="40" Margin="6,0,0,0" Click="Nudge_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Reset position'}" Tag="reset" Margin="14,0,0,0" Click="Nudge_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Tr 'Number shown'}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <RadioButton x:Name="OvNumAll" Style="{StaticResource TabRadio}" Content="{loc:Tr 'All-time'}" GroupName="ovnum" Click="OvNum_Click" IsChecked="True"/>
                                        <RadioButton x:Name="OvNumToday" Style="{StaticResource TabRadio}" Content="{loc:Tr 'Today'}" GroupName="ovnum" Click="OvNum_Click"/>
                                        <RadioButton x:Name="OvNumSession" Style="{StaticResource TabRadio}" Content="{loc:Tr 'This session'}" GroupName="ovnum" Click="OvNum_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                                                <TextBlock Text="{loc:Tr 'FULL OVERLAY'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'The framed overlay. Drag it anywhere on the screen, and right-click it for a menu. The size only changes this one: the minimal overlay follows the game.'}"/>
                                    <TextBlock Text="{loc:Tr 'Size'}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <StackPanel x:Name="SizeRow" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Slider x:Name="SizeSlider" Style="{StaticResource FlatSlider}" Width="240" Minimum="0.6" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Size_Changed"/>
                                        <TextBlock x:Name="SizeText" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'OVERLAY HOTKEY'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'Shows or hides the overlay from the keyboard, even while you are in the game. Click the keys, then press the ones you want (with Ctrl, Alt, Shift or Win).'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="HotkeyBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Show / hide the overlay with'}" Click="Hotkey_Toggle"/>
                                        <Button x:Name="HotkeyBtn" Style="{StaticResource GoldButton}" MinWidth="150" Margin="14,0,0,0" Click="HotkeyBtn_Click" PreviewKeyDown="HotkeyBtn_Key" LostFocus="HotkeyBtn_Lost"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HotkeyMsg" Style="{StaticResource MsgText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SetNotify" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr 'Notifications'}" FontFamily="Segoe UI Black" FontSize="26" Foreground="White"/>
                            <TextBlock Text="{loc:Tr 'Pop-ups and alerts'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,16"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'MATCH POP-UP'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'A silent pop-up in the bottom right corner each time a new match has been counted, for example +12 chests. It does not show after Rescan all or Re-read recent.'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ToastBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Show a pop-up after each match'}" Click="MatchToast_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Test'}" Margin="18,0,0,0" MinWidth="72" Click="MatchToastTest_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'TREASURE HOUR ALERT'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'A pop-up slides in at the top right of your screen even while you are in the game: when a Treasure Hour starts (with a short chime), and as a warning 30 minutes before (silent) and 10 minutes before (with the chime).'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox x:Name="WarnBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Warn me 30 and 10 minutes before'}" Click="Warn_Click" IsChecked="True"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Test'}" Margin="18,0,0,0" MinWidth="72" Click="WarnTest_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="AlertBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Alert me when a Treasure Hour starts'}" Click="Alert_Click" IsChecked="True"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Test'}" Margin="18,0,0,0" MinWidth="72" Click="AlertTest_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SetCount" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr 'Chests and goal'}" FontFamily="Segoe UI Black" FontSize="26" Foreground="White"/>
                            <TextBlock Text="{loc:Tr 'Your count, adjustments and targets'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,16"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'GOAL (OPTIONAL)'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'Set yourself a target and a progress bar appears above your matches on the Overview. Only chests counted from replays are used.'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="GoalOff" Style="{StaticResource TabRadio}" Content="{loc:Tr 'No goal'}" GroupName="goal" Click="Goal_Click" IsChecked="True"/>
                                        <RadioButton x:Name="GoalDay" Style="{StaticResource TabRadio}" Content="{loc:Tr 'Per day'}" GroupName="goal" Click="Goal_Click"/>
                                        <RadioButton x:Name="GoalWeek" Style="{StaticResource TabRadio}" Content="{loc:Tr 'Per week'}" GroupName="goal" Click="Goal_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBox x:Name="GoalBox" Style="{StaticResource GoldBox}" Width="110" PreviewTextInput="Number_PreviewTextInput" KeyDown="GoalBox_KeyDown"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Set target'}" Margin="10,0,0,0" MinWidth="96" Click="Goal_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'ADD CHESTS TO YOUR COUNT'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'LNXcounter can only count the matches it finds as replay files on this PC. If you also play on another device, or played before you installed the app, add those chests here. They are counted as normal chests and are used for your drop odds too.'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBox x:Name="AddBox" Style="{StaticResource GoldBox}" Width="190" MaxLength="9" PreviewTextInput="Number_PreviewTextInput" KeyDown="AddBox_KeyDown"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Add'}" Margin="12,0,0,0" MinWidth="84" Click="AddChests_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Remove'}" Margin="8,0,0,0" MinWidth="84" Click="RemoveChests_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'OR SET YOUR EXACT TOTAL'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'Already know how many chests you opened this season? Type your total and LNXcounter adds whatever its replays did not count to reach it.'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBox x:Name="TotalBox" Style="{StaticResource GoldBox}" Width="190" MaxLength="9" PreviewTextInput="Number_PreviewTextInput" KeyDown="TotalBox_KeyDown"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Set total'}" Margin="12,0,0,0" MinWidth="84" Click="SetTotal_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding ManualInfo}" Foreground="{StaticResource GoldLightBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource MsgText}" Text="{Binding SettingsMessage}" Foreground="#FF6FDB8C" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="{loc:Tr 'Chests added by hand are kept when you press Rescan all, and cleared by Reset.'}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SetData" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr 'Data'}" FontFamily="Segoe UI Black" FontSize="26" Foreground="White"/>
                            <TextBlock Text="{loc:Tr 'Replays, export, backup, logs and uninstall'}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,16"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'DELETE COUNTED REPLAYS'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'Fortnite keeps every replay (15 to 20 MB each) until you delete it. When this is on, LNXcounter deletes a replay for good once it has counted it, but never one that is less than 1 hour old. Your totals are kept. A deleted replay cannot be read again, and it does not go to the Recycle Bin.'}"/>
                                    <CheckBox x:Name="CleanBox" Style="{StaticResource SettingCheck}" Content="{loc:Tr 'Delete replays once they are counted'}" Click="Clean_Click"/>
                                    <TextBlock Style="{StaticResource MsgText}" Text="{Binding CleanMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'EXPORT'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0" LineHeight="19"
                                               Text="{loc:Tr 'Save your chests for each day, week (Monday to Sunday) or month: matches, chests opened and broken, average and the treasures you found. CSV opens in Excel or Google Sheets and has the chests by type too; PDF is a small black and gold report. Chests added by hand get their own line.'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <RadioButton x:Name="FormatCsv" Style="{StaticResource TabRadio}" Content="CSV" GroupName="fmt" IsChecked="True"/>
                                        <RadioButton x:Name="FormatPdf" Style="{StaticResource TabRadio}" Content="PDF" GroupName="fmt"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Per day'}" MinWidth="96" Tag="Daily" Click="ExportCsv_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Per week'}" Margin="8,0,0,0" MinWidth="96" Tag="Weekly" Click="ExportCsv_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Per month'}" Margin="8,0,0,0" MinWidth="96" Tag="Monthly" Click="ExportCsv_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MsgText}" Text="{Binding ExportMessage}" Foreground="#FF6FDB8C" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'BACKUP AND RESTORE'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'Save all your stats (matches, chests added by hand, drops you ticked) to one file, and load it back on this or another PC, for example after reinstalling Windows. Restoring replaces the current stats and restarts the app.'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Back up'}" MinWidth="110" Click="Backup_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Restore'}" MinWidth="110" Margin="8,0,0,0" Click="Restore_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MsgText}" Text="{Binding BackupMessage}" Foreground="#FF6FDB8C" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'LOGS'}" Style="{StaticResource Label}" Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'LNXcounter keeps a small log of what it does: when it starts, each match it reads, update checks and every error. If something goes wrong, copy it and paste it in your bug report. Nothing personal is in it (your Windows user name is hidden) and nothing is ever sent anywhere by itself.'}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Copy the log'}" MinWidth="110" Click="LogCopy_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Save as a file'}" MinWidth="110" Margin="8,0,0,0" Click="LogSave_Click"/>
                                        <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Open the logs folder'}" Margin="8,0,0,0" Click="LogOpen_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LogMsg" Style="{StaticResource MsgText}" Foreground="#FF6FDB8C" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18" BorderBrush="#66FF6B6B">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'UNINSTALL'}" Style="{StaticResource Label}" Foreground="#FFFF6B6B"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,12" LineHeight="19"
                                               Text="{loc:Tr 'Removes LNXcounter completely and leaves nothing behind: the program and its old copies, your stats and settings, the logs, the song player data and the Start with Windows entry. Your Fortnite replays and the files you saved yourself (exports, backups) are not touched. Make a backup first if you may come back. This cannot be undone.'}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{loc:Tr 'Uninstall LNXcounter'}" HorizontalAlignment="Left" Click="Uninstall_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===== DROPS ===== -->
            <Grid x:Name="DropsPanel" Grid.Row="1" Margin="24,10,12,6" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- week 1..5 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Drops.Weeks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="pill" Style="{StaticResource GoldButton}" Content="{Binding Label}" Tag="{Binding Number}" IsEnabled="{Binding Available}"
                                    ToolTip="{Binding Tip}" Click="Week_Click" Margin="0,0,8,0" MinWidth="86"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ended}" Value="True">
                                    <Setter TargetName="pill" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#33D4AF37"/>
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                    <Setter TargetName="pill" Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- header: character, week, title, found, countdown -->
                <Grid Grid.Row="1" Margin="0,12,12,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="{Binding Drops.HeroIcon}" Height="92" Width="92" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Drops.WeekLabel}" Foreground="{Binding Drops.AccentBrush}" Opacity="{Binding Drops.LabelOpacity}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Drops.Title}" FontFamily="Segoe UI Black" FontSize="36" Foreground="{Binding Drops.TitleBrush}" Margin="0,-4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                                <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Drops.HasFound}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drops.HasFound}" Value="True">
                                                <Setter Property="Background" Value="#FF22B04F"/>
                                                <Setter Property="BorderBrush" Value="#FF22B04F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Drops.FoundText}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Drops.EndLabel}" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Drops.Countdown}" Foreground="{Binding Drops.AccentBrush}" FontWeight="Bold" FontSize="30" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,6">

                        <!-- the tile grid: 9 columns x 2 rows of square-ish frames -->
                        <ItemsControl ItemsSource="{Binding Drops.Tiles}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/>
                                            <ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/><ColumnDefinition Width="124"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="126"/></Grid.RowDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                    <Setter Property="Grid.Column" Value="{Binding Col}"/>
                                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColSpan}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:ClipBorder x:Name="tile" Background="{Binding Background}" CornerRadius="14" Margin="5" Cursor="Hand" MouseLeftButtonUp="Tile_Click"
                                                      BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Image x:Name="icon" Source="{Binding Icon}" Width="{Binding IconSize}" Stretch="{Binding IconStretch}"
                                                   VerticalAlignment="{Binding IconAlign}" Margin="{Binding IconMargin}"
                                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.RenderTransform>
                                                    <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform Y="0"/></TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <!-- found: a small black-and-gold gradient over the frame -->
                                            <Border x:Name="foundGlow" Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#66000000" Offset="0"/>
                                                        <GradientStop Color="#00000000" Offset="0.5"/>
                                                        <GradientStop Color="#44E8B923" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- week ended: everything a bit darker -->
                                            <Border x:Name="dimmer" Background="#8C000000" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            <!-- shown on hover: dark shade with the item's category and name -->
                                            <Border x:Name="shade" Opacity="0" VerticalAlignment="Bottom" IsHitTestVisible="False" Padding="11,30,10,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00100C04" Offset="0"/>
                                                        <GradientStop Color="#D9100C04" Offset="0.4"/>
                                                        <GradientStop Color="#F0100C04" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="#FFD7D0B8"/>
                                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Black" FontSize="13" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Style="{StaticResource FoundCheck}" IsChecked="{Binding Found, Mode=TwoWay}" IsEnabled="{Binding CanTick}" Visibility="{Binding CheckVisibility}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" ToolTip="{loc:Tr 'Mark as found'}"/>
                                        </Grid>
                                    </local:ClipBorder>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Found}" Value="True">
                                            <Setter TargetName="foundGlow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="tile" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="tile" Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFF3D766" Offset="0"/>
                                                        <GradientStop Color="#FF2A2005" Offset="0.5"/>
                                                        <GradientStop Color="#FFD4AF37" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dim}" Value="True">
                                            <Setter TargetName="dimmer" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- hover: the picture grows a little and the info shade fades in -->
                                        <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- the token hovers up and down inside its frame -->
                                        <DataTrigger Binding="{Binding Floats}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         From="7" To="-9" Duration="0:0:1.8">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- odds list -->
                        <Border Background="#1C1C1C" CornerRadius="16" Margin="5,12,5,0" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5">
                            <StackPanel>
                                <StackPanel Margin="20,15,20,11">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.5" Duration="0:0:0.9"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.5" Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="{loc:Tr 'DROP ODDS'}" FontFamily="Segoe UI Black" FontSize="15" Foreground="White" Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Tr 'Each chest you open in a normal match'}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    <Border BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="2,0,0,0" Margin="0,10,0,0" Padding="10,1,0,1">
                                        <TextBlock FontSize="12" Foreground="#FFB9B4A6" TextWrapping="Wrap"
                                                   Text="“Treasure drop rates from chests are constant since season launch and don't vary throughout the day, except during Treasure Hours. Other than Gizmos, you can't get the same treasure twice.” – Epic Games"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Drops.Odds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="64">
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                                                <!-- Treasure Hour: the row gets a soft lucky-green tint -->
                                                <Border IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Boosted}" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                <GradientStop Color="#00226B3A" Offset="0"/>
                                                                                <GradientStop Color="#33226B3A" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Grid Margin="16,0">
                                                    <local:ClipBorder Width="46" Height="46" CornerRadius="11" Background="{Binding IconBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </local:ClipBorder>
                                                    <StackPanel Margin="62,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Black" FontSize="14.5" Foreground="White"/>
                                                        <Border CornerRadius="5" Background="#FF14381F" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Boosted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="#FF5BE37D"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OneInText}" FontFamily="Segoe UI Black" FontSize="14.5" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Boosted}" Value="True"><Setter Property="Foreground" Value="#FF5BE37D"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding PctText}" FontSize="11.5" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Boosted}" Value="True"><Setter Property="Foreground" Value="#FF3FA85C"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- expected drops at the user's chest count -->
                        <Border Style="{StaticResource Card}" Margin="5,12,5,0" Padding="16,11">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'EXPECTED FROM YOUR CHESTS'}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Drops.ExpectedText}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{loc:Tr 'Hover a tile to see what it is, tick the box when you find a drop.'}"
                                           FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="20,4,20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- pause / resume reading new matches: two bars, or a play triangle while paused -->
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="30" Margin="0,0,10,0" Click="Pause_Click" ToolTip="{Binding PauseTip}">
                        <Path Data="{Binding PauseIcon}" Fill="{StaticResource GoldBrush}" Stretch="Uniform" Width="11" Height="13"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoldBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OverlayBtn" Style="{StaticResource GoldButton}" Content="{loc:Tr 'Overlay'}" Click="Overlay_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Folder…'}" Click="Folder_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Re-read recent'}" Click="Refresh_Click" Margin="0,0,8,0" ToolTip="{loc:Tr 'Re-reads the replays still on your PC and keeps the older matches as they are.'}"/>
                    <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Rescan all'}" Click="Rescan_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GoldButton}" Content="{loc:Tr 'Reset'}" Click="Reset_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== reward popup ===== -->
            <Grid x:Name="ModalLayer" Grid.RowSpan="3" Panel.ZIndex="50">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Drops.IsModalOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#C0000000" CornerRadius="11" Margin="1" MouseLeftButtonDown="Backdrop_Down"/>
                <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Background="#FF1F1F1F"
                        BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" Padding="22,20,22,18" DataContext="{Binding Drops.Open}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Margin="0,0,44,0">
                                <TextBlock Text="{Binding Category}" FontFamily="Segoe UI Black" FontSize="11.5" Foreground="#FF9A9A9A"/>
                                <TextBlock Text="{Binding ModalTitle}" FontFamily="Segoe UI Black" FontSize="22" Foreground="White" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource CaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Click="ModalClose_Click" FontSize="16"/>
                        </Grid>
                        <local:ClipBorder CornerRadius="14" Height="190" Margin="0,16,0,0" Background="{Binding ModalBg}">
                            <Grid>
                                <Image Source="{Binding Icon}" Stretch="{Binding ModalStretch}" Margin="{Binding ModalMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Button Content="{loc:Tr '▶  PREVIEW'}" Style="{StaticResource PillButton}" Visibility="{Binding LoadingVisibility}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Click="Preview_Click"/>
                            </Grid>
                        </local:ClipBorder>

                        <!-- jam tracks: play the song (official YouTube upload, played inside the app) -->
                        <StackPanel Visibility="{Binding AudioVisibility}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundPlay}" Content="{Binding Audio.PlayGlyph}" Click="Jam_Click"/>
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Margin="12,0,12,0" Minimum="0" Maximum="{Binding Audio.DurMax}" Value="{Binding Audio.Pos, Mode=OneWay}"
                                        PreviewMouseLeftButtonDown="Progress_Down" PreviewMouseLeftButtonUp="Progress_Up"/>
                                <TextBlock Grid.Column="2" Text="{Binding Audio.TimeText}" Foreground="#FF9A9A9A" FontSize="12" VerticalAlignment="Center" MinWidth="78" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Audio.VolumeGlyph}" FontSize="15" Foreground="#FFB9B4A6" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100" Value="{Binding Audio.Volume, Mode=TwoWay}" ToolTip="{loc:Tr 'Volume'}"/>
                                <Button Grid.Column="2" Content="{loc:Tr 'Open on YouTube ↗'}" Style="{StaticResource CaptionButton}" Width="Auto" Height="Auto" Padding="6,3" HorizontalAlignment="Right" FontSize="11" Click="Youtube_Click"/>
                            </Grid>
                            <TextBlock Text="{Binding Audio.Message}" Foreground="#FFE5A23C" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,16,0,0">
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding TierBg}" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding TierText}" Foreground="{Binding TierFg}" FontFamily="Segoe UI Black" FontSize="13"/>
                            </Border>
                            <CheckBox Style="{StaticResource FoundToggle}" IsChecked="{Binding Found, Mode=TwoWay}" IsEnabled="{Binding CanTick}" Visibility="{Binding CheckVisibility}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr 'Only the rewards of the week that is live can be ticked.'}" Visibility="{Binding LockNoteVisibility}"
                                   Foreground="#FFE5A23C" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Info}" Foreground="#FF8F8F8F" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <TextBlock Text="{loc:Tr 'The token is the same in every week, so one tick counts everywhere.'}" Visibility="{Binding SharedNoteVisibility}"
                                   Foreground="#FF6F6F6F" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== loading screen preview ===== -->
            <local:ClipBorder x:Name="PreviewLayer" Grid.RowSpan="3" Panel.ZIndex="60" CornerRadius="11" Margin="1" Background="#F5000000">
                <local:ClipBorder.Style>
                    <Style TargetType="local:ClipBorder">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Drops.Previewing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:ClipBorder.Style>
                <local:ClipBorder Width="1130" Height="635.6" CornerRadius="10" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Image Source="{Binding Drops.Open.Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border VerticalAlignment="Bottom" Height="230" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#A0000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Drops.Connecting}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,40"
                               FontFamily="Segoe UI Black" FontSize="46" Foreground="White">
                        <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.85"/></TextBlock.Effect>
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="600">
                        <Button Style="{StaticResource FnClose}" HorizontalAlignment="Right" Margin="0,0,40,-4" Click="PreviewClose_Click"/>
                        <Grid>
                            <Polygon Points="0,0 600,26 600,150 0,150" Fill="#FF34438F" Stretch="Fill"/>
                            <TextBlock Text="{Binding Drops.Tip}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="21" TextWrapping="Wrap" Margin="34,38,30,22"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                </local:ClipBorder>
            </local:ClipBorder>
        </Grid>
    </Border>
</Window>
