<Window x:Class="LNXcounter.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        Title="{loc:Tr 'Chest map'}" Width="880" Height="940" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_Down">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="✕" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,10,0,10" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True" Background="#FF0B0B0B">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid Width="1000" Height="1000">
                            <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="HeatImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="Layer" Width="1000" Height="1000"/>
                        </Grid>
                    </Viewbox>
                    <!-- what the map shows: the spots or the heat, and this match or every match -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                        <Border Background="#D90B0B0B" CornerRadius="10" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeSpots" Style="{StaticResource TabRadio}" Content="{loc:Tr 'CHEST SPOTS'}" GroupName="mapmode" IsChecked="True" Checked="Opt_Checked"/>
                                <RadioButton x:Name="ModeHeat" Style="{StaticResource TabRadio}" Content="{loc:Tr 'CHEST HEAT'}" GroupName="mapmode" Checked="Opt_Checked"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#D90B0B0B" CornerRadius="10" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" Padding="4,2" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ScopeMatch" Style="{StaticResource TabRadio}" Content="{loc:Tr 'THIS MATCH'}" GroupName="mapscope" IsChecked="True" Checked="Opt_Checked"/>
                                <RadioButton x:Name="ScopeAll" Style="{StaticResource TabRadio}" Content="{loc:Tr 'ALL MATCHES'}" GroupName="mapscope" Checked="Opt_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="2" x:Name="Legend"/>
        </Grid>
    </Border>
</Window>
