<Window x:Class="LNXcounter.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        Title="{loc:Tr 'Chest map'}" Width="880" Height="940" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Title_Down">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="✕" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,10,0,10" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True" Background="#FF0B0B0B">
                <Viewbox Stretch="Uniform">
                    <Grid Width="1000" Height="1000">
                        <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="Layer" Width="1000" Height="1000"/>
                    </Grid>
                </Viewbox>
            </Border>

            <WrapPanel Grid.Row="2" x:Name="Legend"/>
        </Grid>
    </Border>
</Window>
