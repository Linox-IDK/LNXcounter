<Window x:Class="LNXcounter.MatchToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LNXcounter.Services"
        Title="LNXcounter" Width="352" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False" Icon="/Assets/logo.png">
    <Grid Margin="12,10,12,18">
        <Border Background="#F70E0E0E" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Card_Down">
            <Border.Effect><DropShadowEffect Color="#D4AF37" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
            <Grid>
                <Border CornerRadius="11" Opacity="0.9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A2F10" Offset="0"/><GradientStop Color="#0E0E0E" Offset="0.62"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="16,13,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Assets/chest.png" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Chip" Text="{loc:Tr 'MATCH COUNTED'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock FontFamily="{StaticResource PirateFont}" x:Name="Big" FontSize="24" Foreground="{StaticResource GoldGradient}" Margin="0,1,0,0"/>
                            <TextBlock x:Name="Line" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="Extra" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}" Margin="0,3,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="3" Margin="0,12,0,0" Background="#33D4AF37" CornerRadius="1.5" ClipToBounds="True">
                        <Border x:Name="Bar" Background="{StaticResource GoldBrush}" CornerRadius="1.5" HorizontalAlignment="Left" Width="320"/>
                    </Border>
                    <Border Height="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
