<Window x:Class="LNXcounter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LNXcounter overlay" Width="280" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False" Icon="/Assets/logo.png">
    <Border Background="#F2101010" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1" CornerRadius="9"
            MouseLeftButtonDown="Drag_Down" MouseRightButtonUp="Right_Up" Padding="12,8,12,8">
        <StackPanel>
            <!-- header: icon, name, count, chevron -->
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="LNXcounter" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldGradient}"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalOpened}" VerticalAlignment="Center" FontWeight="Bold" FontSize="17" Foreground="{StaticResource GoldLightBrush}" Margin="0,0,6,0"/>
                <Button Grid.Column="3" x:Name="Chevron" Content="⌄" Click="Chevron_Click" Style="{StaticResource CaptionButton}" Width="24" Height="24" FontSize="15"
                        Foreground="{StaticResource GoldBrush}"/>
            </Grid>

            <StackPanel x:Name="Details" Margin="0,6,0,0">
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Treasure Hours" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding PirateShort}" HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </Grid>
                <TextBlock Text="{Binding PirateCountdown}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding OverlayStatus}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="LNXcounter" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GoldDimBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
